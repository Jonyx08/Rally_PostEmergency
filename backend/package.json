{
  "name": "triaje-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API de triaje post-emergencia: sincronización de reportes, clustering espacial y priorización",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && pnpm db:seed",
    "prisma:generate": "prisma generate",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=integration",
    "lint:types": "tsc --noEmit -p tsconfig.json",
    "test:integration": "jest integration"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "dotenv": "^16.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core"
    ]
  }
}

# Conexión a PostgreSQL + PostGIS (la del docker-compose.yml de la raíz del repo)
DATABASE_URL="postgresql://postgres:rallypassword123@localhost:5432/triajedb?schema=public"

# Puerto de la API
PORT=3000

# Orígenes permitidos por CORS, separados por coma (Angular dev server = 4200)
CORS_ORIGINS="http://localhost:4200"

# --- Parámetros del triaje ---
# Distancia máxima (metros) entre reportes de un mismo incidente
TRIAJE_RADIO_METROS=100
# Mínimo de reportes para formar un grupo (1 = un reporte aislado también es incidente)
TRIAJE_MIN_REPORTES=1
# Permite DELETE /api/demo/datos para vaciar el tablero antes de la demo
DEMO_PERMITIR_RESET=true
